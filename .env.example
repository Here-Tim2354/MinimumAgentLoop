# Copy these values into your shell environment before running the agent.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REVIEW_MODEL=deepseek-v4-flash

# 初始权限模式；运行中也可用 /permission-auto、/permission-ask、/permission-deny 切换。
PERMISSION_MODE=autoreview

# 原生 Windows 默认使用 PowerShell；有 Git Bash 时可设为 bash。
AGENT_SHELL=powershell

# 只有在 srt 不在项目 node_modules 中时才需要覆盖它。
# SRT_COMMAND=srt
